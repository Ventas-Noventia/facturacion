# COPIA únicamente las claves que falten a TU .env. No reemplaces tu .env.
# Edita la primera definición de cada clave; no agregues duplicados.
# Primero verifica cuenta, CSD y emisor desde Configuración fiscal.
TIMBRADO_PROVIDER=facturama_sandbox
FACTURAMA_PRODUCTION_ENABLED=false

# Accesos de tu cuenta productiva API, distintos de Sandbox y del e-commerce.
FACTURAMA_PRODUCTION_USERNAME=TU_USUARIO_PRODUCTIVO
FACTURAMA_PRODUCTION_PASSWORD="TU_PASSWORD_PRODUCTIVO"
FACTURAMA_PRODUCTION_RFC=TU_RFC_REAL

# Conserva las credenciales anteriores para consultar/cancelar pruebas guardadas.
# FACTURAMA_USERNAME=TU_USUARIO_SANDBOX
# FACTURAMA_PASSWORD="TU_PASSWORD_SANDBOX"
# FACTURAMA_API_BASE_URL=https://apisandbox.facturama.mx

# El dashboard NO necesita rutas .cer/.key ni la contraseña del sello.
# El CSD ya registrado se consulta por API y nunca se reemplaza desde el dashboard.
# Conserva tus variables existentes de Supabase, Firebase y e-commerce.
